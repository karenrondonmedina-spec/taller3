Algoritmo numeroociclos
	Definir numeroo, numeroCiclos Como Entero
	Escribir " Ingrese la cantidad de numeros en la serie"
	Leer numeroCiclos
	numeroo = 1
	mientras ( numeroo <= numeroCiclos) Hacer
		numeroCiclos = numeroCiclos +1
		Imprimir numeroo
		numeroo = numeroo + 2
	FinMientras
	
		
FinAlgoritmo
