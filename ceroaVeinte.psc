Algoritmo ceroaVeinte
	Definir a Como Entero
		Escribir "Ingrese un numeroo entre 0 y 20"
		Leer a
		si a<0 O a>20
			Escribir "Numeroo invalido"
		SiNo
			si a=2 O a=3 O a=5 O a=7 O a=11 O a=13 O a=17 O a=19
				Escribir "El numeroo es primo"
			SiNo
				Escribir "El numeroo no es primo"
			FinSi
		FinSi
FinAlgoritmo
